# --- Datos TikTok (Apify) -> https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_xxxxxxxx
APIFY_SEARCH_ACTOR=clockworks/tiktok-scraper
APIFY_COMMENTS_ACTOR=clockworks/tiktok-comments-scraper

# --- LLM: Azure OpenAI / Foundry (recomendado) ---
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=xxxxxxxx
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini            # clasificación masiva (barato)
AZURE_OPENAI_ANALYST_DEPLOYMENT=gpt-4.1       # informe en prosa + agente (opcional; si no, usa el anterior)

# --- Alternativa: OpenAI directo (si no hay Azure) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Comportamiento ---
MOCK_MODE=false
OUTPUT_DIR=outputs
SENTIMENT_BATCH_SIZE=40

# --- API de tools (para Foundry) ---
# TOOLS_API_KEY=una-clave-larga
# PUBLIC_BASE_URL=https://tiktok-pulse.<region>.azurecontainerapps.io
OPENAI_ANALYST_MODEL=gpt-4.1   # modelo para el informe en prosa (opcional)
